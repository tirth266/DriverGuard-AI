# ─────────────────────────────────────────────────────────────────────────────
# Flask Server
# ─────────────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
# Signs the session cookie that carries the Google OAuth `state` CSRF value.
# Generate a random value; see JWT_SECRET below for the command.
SECRET_KEY=replace_with_a_random_value_generated_above

# ─────────────────────────────────────────────────────────────────────────────
# Application URLs
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Required for authentication (register, login, Google OAuth, user lookup).
# Set DATABASE_URL to your database connection string.
# DATABASE_URL=sqlite:///driverguard.db

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
# Both secrets below are REQUIRED. There is no fallback: the app refuses to
# start without them, and refuses again if either still holds a placeholder.
# Generate each one with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# They must be different values. SECRET_KEY signs the OAuth state cookie and
# JWT_SECRET signs access tokens, so one leaked key must not compromise both.
JWT_SECRET=replace_with_a_random_value_generated_above

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth 2.0
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Local model files (installed once by: python scripts/setup_models.py)
# ─────────────────────────────────────────────────────────────────────────────
# Relative paths resolve against the backend directory, never the working
# directory. The backend loads these files only; it never downloads a model.
# YOLO_MODEL_PATH=models/trained/yolo11/detection/best.pt
# FACE_TASK_PATH=models/mediapipe/face_landmarker.task
# HAND_TASK_PATH=models/mediapipe/hand_landmarker.task
# YOLO_OFFLINE=true

# ─── TLS ──────────────────────────────────────────────────────────────────────
# The server (run.py) binds plain HTTP on 0.0.0.0 and does not terminate TLS.
# That is fine for local development only. Any deployment reachable by anyone
# else must put a TLS-terminating reverse proxy in front of it and forward
# plain HTTP over a private interface, e.g.
#     nginx -> https://public.example.com -> http://127.0.0.1:5000
# Bearer tokens and camera frames cross that hop in the clear otherwise.
# There is no application-layer encryption: passwords are bcrypt hashes on disk
# and the transport is the only thing protecting data in flight.
